node_modules/

# CI-built output, published to the gh-pages branch and served via jsDelivr.
# Never committed on main — CI is the sole builder (see .github/workflows/deploy.yml).
release/

# Playwright artifacts — regenerated by `pnpm test:e2e`, never committed.
test-results/
playwright-report/

# Wizard intake briefs — generated by /wizard-intake from live API data for a
# specific account. Contains account-scoped template/binary IDs that are not
# portable across accounts and should not be committed to the public repo.
wizards/*/*/TARGET.md
