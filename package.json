{
    "name": "fastedge-wizard-apps",
    "private": true,
    "scripts": {
        "build": "pnpm -r --filter './packages/**' run build && node scripts/build-all.mjs && node scripts/assemble.mjs",
        "assemble": "node scripts/assemble.mjs",
        "bump:sdk": "node scripts/bump-sdk.mjs",
        "lint:css": "stylelint \"wizards/*/src/**/*.css\" \"packages/*/src/**/*.css\" && node scripts/check-tokens.mjs",
        "lint:css:fix": "stylelint \"wizards/*/src/**/*.css\" \"packages/*/src/**/*.css\" --fix",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@gcoredev/fastedge-wizard-sdk": "latest",
        "@playwright/test": "^1.61.1",
        "npm-run-all2": "9.0.2",
        "stylelint": "^17.14.0",
        "stylelint-config-standard": "^40.0.0"
    }
}
